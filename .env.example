# ============================================================
# VAPI - Voice AI
# ============================================================
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ============================================================
# n8n Webhook (production)
# ============================================================
N8N_WEBHOOK_URL=

# ============================================================
# Hostinger MySQL (hPanel > Databases > MySQL Databases)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=5

# Admin session signing key: openssl rand -base64 48
AUTH_SECRET=
# Shared secrets for server-to-server calls
N8N_API_SECRET=
VAPI_WEBHOOK_SECRET=

# ============================================================
# Google Gemini (used by n8n workflow & Qdrant sync script)
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Qdrant Vector DB (used by n8n workflow & sync script)
# ============================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=real_estate_kb

# ============================================================
# Twilio WhatsApp (used by n8n workflow)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
